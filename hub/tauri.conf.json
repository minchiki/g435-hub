{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G435 Hub",
  "version": "1.1.0",
  "identifier": "local.g435hub",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "G435 Hub",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "backgroundColor": "#050607"
      }
    ],
    "security": { "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost blob: data:" }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "publisher": "G435 Hub",
    "shortDescription": "Battery, volume and 3D model for the Logitech G435",
    "category": "Utility",
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["English", "Russian"], "displayLanguageSelector": true },
      "wix": { "language": "en-US" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2OTRDNjY3Mzc3QzE0OTUKUldTVkZIdzNaOGFVVnBVeE5XeE40eTIvODlHbzdjVElhSVp6SXRzQ3oyRGxkOVAwRTV3eG9nUHYK",
      "endpoints": ["https://github.com/minchiki/g435-hub/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
